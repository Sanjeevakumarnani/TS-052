# InfraPulse Backend — Environment Variables
# Copy this file to `.env` and fill in values before running in production.
# Never commit `.env` to version control.

# ---------------------------------------------------------------------------
# CORS — comma-separated allowed origins for the frontend
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Security: token signing secret
# MUST be changed to a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
SESSION_SECRET=infrapulse-default-insecure-secret-key-change-in-prod

# ---------------------------------------------------------------------------
# Admin bootstrap: if set, creates an admin account on first startup.
# Leave blank to skip auto-creation (you can use POST /api/v1/auth/register).
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# Legacy reviewer token (for the simple /reviewer/* endpoints).
# Leave blank to disable those endpoints (501 Not Implemented).
# ---------------------------------------------------------------------------
REVIEWER_TOKEN=

# ---------------------------------------------------------------------------
# AI Vision: Google Gemini key for evidence image analysis.
# Leave blank → AI returns honest "not_configured" fallback (no fake results).
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
VISION_AI_MODEL=gemini-1.5-flash
VISION_AI_TIMEOUT=25.0

# ---------------------------------------------------------------------------
# Geolocation: max distance (metres) from village centroid to count as match.
# Default 5 km — increase for large/dispersed villages.
# ---------------------------------------------------------------------------
LOCATION_MATCH_RADIUS_METERS=5000

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_REPORTS=10
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN=20

